{
	"name": "scheduling-bridge.tinyland.dev",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"description": "Brand site for scheduling-bridge — monadic booking middleware for hostile calendar stacks (static SvelteKit 3, Skeleton 5, Bazel + Nix + Just)",
	"homepage": "https://github.com/xoxd-ai/scheduling-bridge.tinyland.dev",
	"repository": {
		"type": "git",
		"url": "https://github.com/xoxd-ai/scheduling-bridge.tinyland.dev.git"
	},
	"license": "MIT",
	"packageManager": "pnpm@10.13.1",
	"engines": {
		"node": "^22.17.0 || >=24 <25"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsgo --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsgo --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest",
		"test:unit": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test"
	},
	"dependencies": {
		"@fontsource/inter": "^5.2.8",
		"@lucide/svelte": "^1.23.0",
		"effect": "4.0.2"
	},
	"devDependencies": {
		"@playwright/test": "1.64.0",
		"@skeletonlabs/skeleton": "5.0.1",
		"@skeletonlabs/skeleton-svelte": "5.0.1",
		"@sveltejs/adapter-static": "4.0.0",
		"@sveltejs/kit": "3.0.1",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/vite": "^4.3.2",
		"@types/node": "^22.20.1",
		"@typescript/typescript6": "6.0.2",
		"@vitest/coverage-v8": "5.0.3",
		"eslint": "^9.39.2",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.20.0",
		"globals": "^17.7.0",
		"magic-string": "^0.30.0",
		"prettier": "^3.9.4",
		"prettier-plugin-svelte": "^3.4.1",
		"serve": "^14.2.5",
		"shiki": "^4.3.1",
		"svelte": "5.57.2",
		"svelte-check": "4.7.6",
		"tailwindcss": "^4.3.2",
		"tsx": "^4.23.0",
		"typescript": "7.0.2",
		"typescript-eslint": "^8.71.1",
		"vite": "8.3.3",
		"vitest": "5.0.3"
	},
	"pnpm": {
		"overrides": {
			"cookie@<0.7.0": "0.7.2",
			"fast-uri": "3.1.2"
		},
		"packageExtensions": {
			"@sveltejs/kit@3.0.1": {
				"peerDependencies": {
					"@typescript/typescript6": "^6.0.0"
				},
				"peerDependenciesMeta": {
					"@typescript/typescript6": {
						"optional": true
					}
				}
			}
		},
		"peerDependencyRules": {
			"allowedVersions": {
				"@sveltejs/kit>typescript": "7"
			}
		},
		"patchedDependencies": {
			"@sveltejs/kit@3.0.1": "patches/@sveltejs__kit@3.0.1.patch",
			"devalue@5.9.4": "patches/devalue@5.9.4.patch",
			"svelte-check@4.7.6": "patches/svelte-check@4.7.6.patch"
		},
		"onlyBuiltDependencies": [
			"@tailwindcss/oxide",
			"esbuild"
		]
	}
}
